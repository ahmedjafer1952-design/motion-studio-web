# Copy this file to .env.local and fill it in. .env.local is never committed.
#
# Your Claude API key (https://console.anthropic.com → API Keys). Used by `npm run dev`
# and by the Netlify function to power "✨ Auto Edit with Claude". It stays on the server.
ANTHROPIC_API_KEY=

# Optional: if set, the editor must send this code before the server will call Claude.
# Use it on a public deployment so strangers can't spend your API credit.
AI_ACCESS_CODE=
